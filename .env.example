# ── Telegram ──────────────────────────────────────────────────────────────────
# Token dari @BotFather
TELEGRAM_BOT_TOKEN=

# Channel wajib join sebelum masuk menu (contoh: @nelstores)
FORCE_SUB_CHANNEL=@nelstores

# ── Admin ─────────────────────────────────────────────────────────────────────
# Telegram ID admin (angka). Cara tahu ID: chat dengan @userinfobot
ADMIN_TELEGRAM_ID=

# ── PayKita ───────────────────────────────────────────────────────────────────
# API key dari dashboard PayKita (pay.digikita.id → API Keys)
PAYKITA_API_KEY=pk_live_YOUR_API_KEY

# Base URL REST API PayKita (jangan diubah kecuali ada instruksi dari PayKita)
PAYKITA_BASE_URL=https://pay.digikita.id/api

# Webhook secret untuk verifikasi HMAC-SHA256
# Ambil dari: dashboard PayKita → Settings → Webhook
# TODO: Isi setelah mendapatkan nilai dari dashboard
PAYKITA_WEBHOOK_SECRET=

# ── FastAPI Webhook Server ────────────────────────────────────────────────────
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000

# URL publik server Anda (dengan https), daftarkan ke PayKita sebagai webhook URL:
# https://yourdomain.com/webhook/paykita
PUBLIC_URL=https://yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=data/orders.db

# ── Pengaturan Order ──────────────────────────────────────────────────────────
# Durasi order kedaluwarsa (menit)
ORDER_EXPIRY_MINUTES=30
